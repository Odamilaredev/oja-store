generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  orders       Order[]
}

model Product {
  id         String      @id @default(cuid())
  slug       String      @unique
  name       String
  category   String
  description String
  price      Int
  stock      Int
  imageUrl   String
  tag        String?
  featured   Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  orderItems OrderItem[]
}

model Order {
  id              String      @id @default(cuid())
  userId          String?
  email           String
  total           Int
  status          OrderStatus @default(PENDING)
  stripeSessionId String?     @unique
  shippingName    String
  shippingPhone   String
  shippingAddress String
  shippingCity    String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User?       @relation(fields: [userId], references: [id])
  items           OrderItem[]
}

model OrderItem {
  id       String  @id @default(cuid())
  orderId  String
  productId String
  name     String
  price    Int
  quantity Int
  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product  Product @relation(fields: [productId], references: [id])
}

model PromoCode {
  id        String    @id @default(cuid())
  code      String    @unique
  type      String
  value     Int
  active    Boolean   @default(true)
  maxUses   Int?
  usedCount Int       @default(0)
  expiresAt DateTime?
}
